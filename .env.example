# ===========================================================================
# 环境变量示例 —— 复制为 .env 后按需填写
#
#   cp .env.example .env
#
# 说明：
#   - 所有变量都是可选的，留空走代码内默认值或对应功能关闭。
#   - 第三方 API key 也可以在 Web UI「全局配置」里配置，二选一即可。
#   - 切勿把填好真实值的 .env 提交进 git（已在 .gitignore 忽略）。
# ===========================================================================

# ----- 主服务 -------------------------------------------------------------
# 访问密码：设置后所有 /api 请求需携带该密码（Bearer / 查询参数）。
# 公网部署强烈建议设置。留空 = 无密码保护。
APP_PASSWORD=
# 数据库连接串。默认使用项目根目录下的 account_manager.db。
# Docker 持久化示例：sqlite:////app/data/account_manager.db
ACCOUNT_MANAGER_DATABASE_URL=
# 微软邮箱凭据加密密钥。留空时首次导入会自动生成到 data/.microsoft_mailbox.key。
# 如手动设置，请长期保持不变；丢失或更换后已入库凭据无法解密。
MICROSOFT_MAILBOX_ENCRYPTION_KEY=
MICROSOFT_MAILBOX_ENCRYPTION_KEY_FILE=
# Set to 0 for isolated local registration tests without scheduled checks.
BACKGROUND_JOBS_ENABLED=1

# Optional runtime override for an Inbucket API stored with a Docker-only URL.
# Example for a local SSH tunnel: http://127.0.0.1:19000/api/v1
CHATGPT_INBUCKET_API_URL=

# ----- ChatGPT 无头浏览器池 -----------------------------------------------
# 4 x 6 = 最多 24 个同时活跃的注册 Context；给 Firefox 和系统保留内存余量。
BROWSER_POOL_SIZE=4
BROWSER_POOL_MAX_CONTEXTS=6
# 每 175ms 启动一个新页面，削平同时导航造成的 CPU 峰值。
BROWSER_CONTEXT_START_INTERVAL_MS=175
# 同时进行登录页加载/表单 hydration 的上限；OTP 等待不受此限制。
BROWSER_POOL_STARTUP_CONCURRENCY=8
# 每个 Camoufox 完成 12 个注册 worker 后平滑轮换，清理 Firefox 长期堆积。
BROWSER_MAX_REGISTRATIONS_PER_PROCESS=12
BROWSER_RECYCLE_DRAIN_TIMEOUT_SECONDS=20
BROWSER_LAUNCH_ATTEMPTS=3
# 注册表单不依赖图片；关闭图片下载/解码可显著降低带宽和渲染开销。
CHATGPT_BROWSER_BLOCK_IMAGES=1

# ----- 每日 401 验活 ------------------------------------------------------
# 按指定时区每天到点创建一次 401 验活任务；服务到点后才启动会补建当天任务。
DAILY_401_CHECK_HOUR=3
DAILY_401_CHECK_CONCURRENCY=100
DAILY_401_CHECK_TIMEZONE=Asia/Shanghai

# ----- Mihomo / Clash 注册代理 --------------------------------------------
APP_RUNTIME_MODE=desktop
# Docker Compose 默认使用以下内部地址；本机直跑后端时按实际端口修改。
MIHOMO_CONTROLLER_URL=http://mihomo:9090
MIHOMO_CONFIG_FILE=deploy/mihomo/config.yaml
MIHOMO_CONFIG_RELOAD_PATH=/root/.config/mihomo/config.yaml
MIHOMO_PROXY_URL=http://mihomo:7890
MIHOMO_PROXY_GROUP=REGISTER-ALL
MIHOMO_SLOT_GROUP_PREFIX=REGISTER-SLOT-
MIHOMO_SLOT_PORT_BASE=7900
MIHOMO_SLOT_COUNT=50
MIHOMO_NODE_COOLDOWN_SECONDS=120
MIHOMO_CONTROLLER_SECRET=

# ----- ChatGPT Sentinel 纯协议 V8 -----------------------------------------
# 6 核服务器建议 3 个常驻 Node worker；50 个注册线程共享此池，不会启动浏览器。
CHATGPT_SENTINEL_VM_WORKERS=3
# 协议登录与注册一致，最多 50 路；不要与常驻 V8 worker 数绑定。
CHATGPT_PROTOCOL_LOGIN_CONCURRENCY=50
# V8 时区应与每个出口节点的地区保持一致。
CHATGPT_SENTINEL_TIMEZONE=America/New_York
# 自动从 Sentinel frame.html 探测并缓存新 SDK；默认每小时检查一次。
SENTINEL_SDK_AUTO_UPDATE=1
SENTINEL_SDK_REFRESH_SECONDS=3600
SENTINEL_SDK_CACHE_DIR=/app/data/sentinel-sdk

# ----- Docker / noVNC ------------------------------------------------------
# headed 浏览器模式下 noVNC 的访问密码。留空 = 无密码。
VNC_PASSWORD=

# ----- 本地 Turnstile Solver ----------------------------------------------
# 本地 Camoufox solver 监听端口（默认 5073，容器内对外暴露 8889）。
SOLVER_PORT=

# ----- BitBrowser（比特浏览器，可选的浏览器后端）---------------------------
# 在 BitBrowser GUI 手工创建 profile 后填其 ID；UI 表单留空时回退到此变量。
BIT_PROFILE_ID=
# BitBrowser 本地 API 地址，默认 http://127.0.0.1:54345
BIT_API_URL=
# 企业版需要的 API token，社区版留空。
BIT_API_TOKEN=

# ----- ChatGPT Plus 协议结账 -----------------------------------------------
# 协议化结账实采开关（live 模式）。详见 platforms/chatgpt。
CHATGPT_PROTOCOL_CHECKOUT_LIVE=

# ----- 接码服务 API key（也可在 Web UI 配置）-------------------------------
# HeroSMS（GoPay 注册 / 印尼号默认渠道）
OPAI_HEROSMS_API_KEY=
# 从文件读取 HeroSMS key（与上面二选一，适合挂载 secret 文件）
OPAI_HEROSMS_API_KEY_FILE=
# SMSPool
OPAI_SMSPOOL_API_KEY=
OPAI_SMSPOOL_COUNTRY=9
OPAI_SMSPOOL_SERVICE=392
OPAI_SMSPOOL_MAX_PRICE=0.11
OPAI_SMSPOOL_PRICING_OPTION=0
# SMSBower
OPAI_SMSBOWER_API_KEY=
OPAI_SMSBOWER_COUNTRY=6
OPAI_SMSBOWER_SERVICE=ni

# ----- GoPay 付款 ChatGPT Plus（本项目扩展功能）----------------------------
# GoPay 账号默认 PIN（注册新号 / 付款时使用，可被任务参数 gopay_pin 覆盖）。
OPAI_GOPAY_DEFAULT_PIN=
# GoPay 注册 / 付款专用出口代理（留空走全局代理池）。
OPAI_GOPAY_REGISTER_PROXY=
# 旋转代理模板（含占位符的代理 URL 模板，按需填写）。
OPAI_GOPAY_PROXY_TEMPLATE=
# 付款前账号余额 / 时效相关阈值（一般保持默认即可）。
OPAI_GOPAY_MIN_BALANCE_RP=1
OPAI_GOPAY_MIN_REMAINING_SEC=300
OPAI_GOPAY_ACCOUNT_TTL_SEC=1200
OPAI_GOPAY_POLL_INTERVAL=10

# ----- GoPay Payment Inbox（可选，独立 worker 队列服务）--------------------
# 仅在使用 platforms/gopay-deploy 的独立 Inbox 服务时需要。不用则全部留空。
OPAI_PAYMENT_INBOX_BASE_URL=
OPAI_PAYMENT_INBOX_TOKEN=
OPAI_PAYMENT_INBOX_BASIC_USER=
OPAI_PAYMENT_INBOX_BASIC_PASS=
OPAI_PAYMENT_INBOX_HOST=0.0.0.0
OPAI_PAYMENT_INBOX_PORT=18130
OPAI_PAYMENT_INBOX_PATH=
OPAI_PAYMENT_INBOX_DB_PATH=
OPAI_PAYMENT_INBOX_RETENTION_SEC=604800

# ----- 注册行为默认值（OpenAI 风控相关）------------------------------------
# OpenAI 把 parent+tag@ 视为同一账号，子地址注册会 user_already_exists；
# 因此默认「一个邮箱一个号」，不再拆分。
# POST_REGISTER_RECHECK_ENABLED=0：注册后不再自动排延迟复验，避免反复登录取码导致封号。
POST_REGISTER_RECHECK_ENABLED=0
# 指纹模式：safari（默认，auth.openai.com 只放行 safari184）/ rotate（旧版轮换）
CHATGPT_FINGERPRINT_MODE=safari
